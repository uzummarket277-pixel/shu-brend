# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Telegram Bot Integratsiyasi (Administratorga yangi buyurtmalar xabari uchun)
# BotFather orqali olingan token (masalan: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Xabarlar yuboriladigan admin yoki guruh/kanal chat ID raqami (masalan: 987654321)
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Admin panel boshqaruvchi ma'lumotlari
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="shu_brend_secure_password_2026"

# Sessiya va token maxfiy kaliti
SESSION_SECRET="shu_brend_super_secret_session_key_2026"
